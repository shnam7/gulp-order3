{
  "name": "gulp-order3",
  "version": "1.0.4",
  "description": "An ESM type gulp plugin that re-orders the files in gulp stream.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "lint": "run-p lint:*",
    "lint:ts": "biome check .",
    "lint:ts:types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "clean": "rimraf ./dist ./coverage",
    "rebuild": "run-s clean build",
    "prepare-to-commit": "run-s rebuild lint test",
    "prepublishOnly": "bun run build",
    "npm-dry-run": "npm publish --dry-run",
    "reset": "run-s clean reset:node",
    "reset:node": "find . -type d -name node_modules -exec rm -rf {} +"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shnam7/gulp-order3.git"
  },
  "homepage": "https://github.com/shnam7/gulp-order3#readme",
  "bugs": {
    "url": "https://github.com/shnam7/gulp-order3/issues"
  },
  "author": "Robin Nam (https://github.com/shnam7)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gulp",
    "gulp4",
    "plugin",
    "order",
    "pipe",
    "esm",
    "es6",
    "es2015",
    "typescript"
  ],
  "dependencies": {
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/stringify-object": "^4.0.5",
    "@types/vinyl": "^2.0.12",
    "@vitest/coverage-v8": "^5.0.5",
    "changesets": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "p-event": "^8.0.1",
    "rimraf": "^6.1.3",
    "strip-ansi": "^7.2.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vinyl": "^3.0.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=15"
  },
  "packageManager": "bun@1.4.4"
}
