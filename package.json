{
    "name": "gulp-order3",
    "version": "1.0.4",
    "description": "An ESM type gulp plugin that re-orders the files in gulp stream.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.js"
    },
    "files": [
        "dist/*"
    ],
    "scripts": {
        "dev": "pnpm run build --watch",
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "lint": "tsc && xo",
        "clean": "rimraf ./dist ./coverage",
        "test": "vitest run --coverage",
        "test:watch": "vitest watch --coverage",
        "rebuild": "run-s clean build",
        "prepare-to-commit": "run-s rebuild lint test",
        "npm-dryrun": "npm publish --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shnam7/gulp-order3.git"
    },
    "homepage": "https://github.com/shnam7/gulp-order3#readme",
    "bugs": {
        "url": "https://github.com/shnam7/gulp-order3/issues"
    },
    "author": "Robin Nam (https://github.com/shnam7)",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "gulp",
        "gulp4",
        "plugin",
        "order",
        "pipe",
        "esm",
        "es6",
        "es2015",
        "typescript"
    ],
    "dependencies": {
        "minimatch": "^10.1.1"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@types/minimatch": "^6.0.0",
        "@types/node": "^25.0.10",
        "@types/vinyl": "^2.0.12",
        "@vitest/coverage-v8": "^4.0.18",
        "changesets": "^1.0.2",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.1.2",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vinyl": "^3.0.1",
        "vitest": "^4.0.18",
        "xo": "^1.2.3"
    },
    "engines": {
        "node": ">=15"
    },
    "packageManager": "pnpm@10.28.1"
}
